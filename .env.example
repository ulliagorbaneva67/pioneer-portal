PIONEER_SECRET_KEY=replace-with-a-long-random-value
PIONEER_ACCESS_PASSWORD=replace-with-a-strong-shared-password
PIONEER_DATA_DIR=/home/your-pythonanywhere-user/pioneer-data
PIONEER_HTTPS=1
PIONEER_REQUIRE_PERSONAL_LOGIN=1
PIONEER_SMTP_HOST=smtp.example.com
PIONEER_SMTP_PORT=587
PIONEER_SMTP_TLS=1
PIONEER_SMTP_SSL=0
PIONEER_SMTP_USER=portal@example.com
PIONEER_SMTP_PASSWORD=replace-with-an-app-password
PIONEER_SMTP_FROM=portal@example.com
